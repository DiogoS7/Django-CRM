# Copy this file to .env and adjust the values. Never commit .env.

DJANGO_DEBUG=True
# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "sqlite" (default, no setup needed) or "mysql"
DB_ENGINE=sqlite

# Only used when DB_ENGINE=mysql
DB_NAME=dcrm
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
